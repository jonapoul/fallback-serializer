{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "extends": [
    "github>jonapoul/renovate-config:default.json5"
  ],
  "packageRules": [
    {
      // Deliberately unsupported Kotlin version, for the Gradle plugin's version check test
      "matchFileNames": ["gradle-plugin/build.gradle.kts"],
      "matchPackageNames": ["org.jetbrains.kotlin:kotlin-gradle-plugin"],
      "enabled": false
    }
  ]
}
